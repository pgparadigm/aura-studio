{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pgparadigm.github.io/aura-studio/aura-project.schema.json",
  "title": "Aura Studio project file",
  "description": "Schema for a .aura project export (schema version 2). The top level is human-readable; nested arrays (mixer, effects, patterns, accents, melodies) stay positional for size and are documented field-by-field in AURA_PROJECT_SCHEMA.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "project"],
  "properties": {
    "format": { "const": "aura-project" },
    "schemaVersion": {
      "type": "integer", "minimum": 1, "maximum": 2,
      "description": "File-format version. This schema describes version 2; a higher number means a newer, unsupported format."
    },
    "appVersion": {
      "type": "string",
      "description": "Semantic version of the Aura build that wrote the file (e.g. \"13.0.0\")."
    },
    "projectId": {
      "type": "string",
      "description": "Stable identity for this project. A UUID (crypto.randomUUID) where available, otherwise an aura_ id."
    },
    "name": { "type": "string" },
    "createdAt": { "type": "string", "description": "ISO-8601 timestamp; set once when the project id is minted." },
    "updatedAt": { "type": "string", "description": "ISO-8601 timestamp; refreshed on every save." },
    "capabilities": {
      "type": "object",
      "description": "What this build of Aura supports. An object (not an array) so new capabilities can be added explicitly and stay forward-compatible.",
      "additionalProperties": { "type": "boolean" }
    },
    "mediaPersistence": {
      "type": "object",
      "description": "SCHEMA-level guarantee about what this file format embeds — never project-specific. Distinct from content.hasVocalTakes / content.hasImportedAudio, which describe whether the CURRENT project holds such material in the app. Both flags are const false: a file asserting embedded audio is not a valid Aura project.",
      "additionalProperties": true,
      "properties": {
        "vocalTakesEmbedded": { "const": false },
        "importedAudioEmbedded": { "const": false }
      }
    },
    "content": {
      "type": "object",
      "description": "What is actually in THIS project, computed from state. Symmetrical with capabilities.",
      "additionalProperties": true,
      "properties": {
        "hasDrums": { "type": "boolean" },
        "hasChords": { "type": "boolean" },
        "hasBass": { "type": "boolean" },
        "hasMelody": { "type": "boolean" },
        "hasArrangement": { "type": "boolean" },
        "hasMixerOverrides": { "type": "boolean" },
        "hasVocalTakes": { "type": "boolean" },
        "hasImportedAudio": { "type": "boolean" }
      }
    },
    "encoding": { "type": "object", "description": "Human note on how the compact nested arrays are laid out." },
    "note": { "type": "string" },
    "project": { "$ref": "#/definitions/state" }
  },
  "definitions": {
    "mask": {
      "type": "integer", "minimum": 0, "maximum": 65535,
      "description": "16-bit step bitmask; bit s (1<<s) marks step s active, 16 steps."
    },
    "slot": {
      "type": ["integer", "null"], "minimum": 0, "maximum": 5,
      "description": "Arrangement slot: a section index 0-5, or null for an empty bar."
    },
    "laneRow": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": { "$ref": "#/definitions/mask" },
      "description": "One section: 13 lane masks [kick,snare,clap,hat,openhat,shaker,deg0..deg6]."
    },
    "drumRow": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": { "$ref": "#/definitions/mask" },
      "description": "One section of accents: 6 drum masks [kick,snare,clap,hat,openhat,shaker]."
    },
    "noteTuple": {
      "type": "array", "minItems": 4, "maxItems": 4, "additionalItems": false,
      "items": [
        { "type": "integer", "minimum": 48, "maximum": 83, "description": "pitch (MIDI)" },
        { "type": "integer", "minimum": 0, "maximum": 15, "description": "start step" },
        { "type": "integer", "minimum": 1, "maximum": 16, "description": "length in steps" },
        { "type": "integer", "minimum": 30, "maximum": 130, "description": "velocity %" }
      ]
    },
    "channelStrip": {
      "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "number" },
      "description": "[vol,pan,mute,solo,lo,mid,hi,rev,dly]."
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["patterns"],
      "properties": {
        "internalStateVersion": { "type": "integer", "minimum": 1 },
        "stateVersion": { "type": "integer", "minimum": 1 },
        "keyIndex": { "type": "integer", "minimum": 0, "maximum": 11 },
        "mode": { "enum": ["major", "minor", "dorian", "phrygian", "harmonicMinor"] },
        "tempo": { "type": "number", "minimum": 60, "maximum": 160 },
        "swing": { "type": "number", "minimum": 0, "maximum": 60 },
        "reverb": { "type": "number", "minimum": 0, "maximum": 100 },
        "chordSound": { "enum": ["pad", "piano", "soul", "pluck"] },
        "bassSound": { "enum": ["sub", "808"] },
        "melodySound": { "enum": ["lead", "pluck", "keys", "pad", "bell", "b808"] },
        "chordVolume": { "type": "number", "minimum": 0, "maximum": 100 },
        "bassVolume": { "type": "number", "minimum": 0, "maximum": 100 },
        "masterVolume": { "type": "number", "minimum": 0, "maximum": 100 },
        "melodyVolume": { "type": "number", "minimum": 0, "maximum": 100 },
        "countIn": { "enum": [0, 1] },
        "autoFill": { "enum": [0, 1] },
        "currentSection": { "type": "integer", "minimum": 0, "maximum": 5 },
        "sectionNames": { "type": "array", "maxItems": 6, "items": { "type": "string" } },
        "drumVolumes": { "type": "array", "maxItems": 6, "items": { "type": "integer", "minimum": 0, "maximum": 300 } },
        "mixer": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/channelStrip" } },
        "effects": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "patterns": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/definitions/laneRow" },
          "description": "Exactly 6 sections."
        },
        "accents": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/definitions/drumRow" }
        },
        "melodies": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "type": "array", "items": { "$ref": "#/definitions/noteTuple" } },
          "description": "Exactly 6 sections; each a list of note tuples."
        },
        "arrangement": {
          "type": "array", "minItems": 32, "maxItems": 32,
          "items": { "$ref": "#/definitions/slot" },
          "description": "Exactly 32 bars."
        },
        "mutes": { "type": "object" }
      }
    }
  }
}
